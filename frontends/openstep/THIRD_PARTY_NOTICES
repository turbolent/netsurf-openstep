  Duktape 2.7.0                 Duktape-LICENSE-AUTHORS.txt
  DejaVu Fonts 2.37             LICENSE-DejaVu
  zlib                          zlib/LICENSE
  libpng                        libpng/LICENSE
  Independent JPEG Group       jpeg/README
  OpenSSL                       openssl/LICENSE
  curl                          curl/COPYING
  Expat                         expat/COPYING
  FreeType                      freetype/LICENSE.TXT, freetype/docs/*
  utf8proc and Unicode data     utf8proc/LICENSE.md
  GNU libiconv/libcharset       libiconv/COPYING.LIB, libiconv/libcharset/COPYING.LIB
  GCC runtime support          gcc42/gcc/libgcc-exception.txt, gcc42/COPYING
